{
  "id": "cocos2dx-compat",
  "name": "Cocos2d-x Compatibility",
  "version": "0.1.3",
  "kind": "general",
  "category": "Engine compatibility",
  "description": "Experimental ARM32 Cocos2d-x JNI/GLES runtime with common PV7 supervisor. Other Cocos versions and custom native dependencies are unverified.",
  "targets": {
    "abis": [
      "armeabi",
      "armeabi-v7a"
    ],
    "engines": [
      "cocos2dx"
    ]
  },
  "dependencies": [
    "core-compat"
  ],
  "suggestedWhenMatched": true,
  "operations": [
    {
      "type": "compat.module",
      "value": "cocos2dx"
    }
  ],
  "payloadFiles": [
    "lib/arm64-v8a/libpv7cocosprobe.so.pv7z",
    "lib/x86_64/libpv7cocosprobe.so.pv7z"
  ]
}
