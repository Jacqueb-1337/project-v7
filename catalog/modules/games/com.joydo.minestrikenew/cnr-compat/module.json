{
    "id":  "cnr-compat",
    "name":  "CNR64 Compatibility",
    "version":  "1.0.1",
    "kind":  "game",
    "description":  "Cops N Robbers 3.0.2 compatibility module for its legacy Unity 4.6 runtime.",
    "targets":  {
                    "packageIds":  [
                                       "com.joydo.minestrikenew"
                                   ],
                    "versions":  [
                                     "3.0.2",
                                     "3.0.2-cnr1"
                                 ],
                    "abis":  [
                                 "armeabi-v7a"
                             ],
                    "engines":  [
                                    "unity"
                                ],
                    "engineVersions":  [
                                           "4.6.*"
                                       ]
                },
    "dependencies":  [
                         "core-compat"
                     ],
    "operations":  [
                       {
                           "type":  "compat.module",
                           "value":  "cnr"
                       },
                       {
                           "type":  "wrapper.addDocumentsProvider",
                           "value":  {
                                         "className":  "app.projectv7.wrapper.CNRModsDocumentsProvider",
                                         "authoritySuffix":  ".documents"
                                     }
                       }
                   ],
    "payloadFiles":  [
                         "assets/pv7/compat.properties",
                         "assets/pv7/host.properties"
                     ]
}
