{
  "id": "cnr-compat",
  "name": "CNR64 Compatibility",
  "version": "1.0.9",
  "kind": "game",
  "description": "CNR binary-specific Unity 4.6.1f1 compatibility, verified ARM64 cooperative-wait host, and pinned managed CNR mod bootstrap without overwriting custom installations.",
  "targets": {
    "packageIds": [
      "com.joydo.minestrikenew"
    ],
    "versions": [
      "3.0.2",
      "3.0.2-cnr1"
    ],
    "abis": [
      "armeabi-v7a"
    ],
    "engines": [
      "unity"
    ],
    "engineVersions": [
      "4.6.*"
    ]
  },
  "dependencies": [
    "core-compat",
    "unity-4.6-compat"
  ],
  "operations": [
    {
      "type": "compat.module",
      "value": "cnr"
    },
    {
      "type": "wrapper.addDocumentsProvider",
      "value": {
        "className": "app.projectv7.wrapper.CNRModsDocumentsProvider",
        "authoritySuffix": ".documents"
      }
    }
  ],
  "payloadFiles": [
    "assets/pv7/compat.properties",
    "assets/pv7/host.properties",
    "assets/bootstrap/CNRModManager.dll",
    "assets/bootstrap/CNRModManager.dll.sha256",
    "assets/bootstrap/repo-sources.txt",
    "assets/bootstrap/repo-sources.txt.sha256",
    "assets/bootstrap/CNRMod.dll",
    "assets/bootstrap/CNRMod.dll.sha256",
    "assets/bootstrap/CNRSettingsMod.dll",
    "assets/bootstrap/CNRSettingsMod.dll.sha256",
    "assets/bootstrap/GraphicsSettings.dll",
    "assets/bootstrap/GraphicsSettings.dll.sha256",
    "lib/arm64-v8a/libpv7host.so.pv7z"
  ]
}
