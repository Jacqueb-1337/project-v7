 #if defined(__ANDROID__)
     // Called only on the guest render thread, with an acquired replacement
     // window from the JNI queue. Guest EGL handles and the context stay stable.
+    // The guest sees one stable window proxy, not a host pointer. Maintain
+    // logical guest references and one native pin while any reference exists.
+    bool AcquireGuestWindowReference() {
+        auto* window = static_cast<ANativeWindow*>(host_native_window_);
+        if (!window || guest_window_refs_ == 0xffffffffu) return false;
+        if (!guest_window_refs_) {
+            ANativeWindow_acquire(window);
+            guest_window_pin_ = window;
+        }
+        ++guest_window_refs_;
+        return true;
+    }
+
+    bool ReleaseGuestWindowReference() {
+        if (!guest_window_refs_) return false;
+        if (--guest_window_refs_ == 0 && guest_window_pin_) {
+            ANativeWindow_release(guest_window_pin_);
+            guest_window_pin_ = nullptr;
+        }
+        return true;
+    }
+
     bool RebindGuestHostWindow(ANativeWindow* next) {
