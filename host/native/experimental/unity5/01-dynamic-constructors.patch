+// The ELF loader, not a particular Unity release, owns constructor discovery.
+struct GuestInitializers {
+    std::uint32_t init = 0;
+    std::uint32_t array = 0;
+    std::uint32_t array_size = 0;
+};
+
+bool GuestSegmentContains(const GuestImage& image, std::uint32_t relative,
+                          std::uint32_t size, std::uint32_t required_flags) {
+    if (image.ehdr.phentsize < sizeof(Elf32Phdr)) return false;
+    for (std::uint32_t i = 0; i < image.ehdr.phnum; ++i) {
+        Elf32Phdr ph{};
+        if (!ReadStruct(image.file, static_cast<std::size_t>(image.ehdr.phoff) +
+                        static_cast<std::size_t>(i) * image.ehdr.phentsize, ph)) return false;
+        if (ph.type != kProgramTypeLoad || (ph.flags & required_flags) != required_flags) continue;
+        if (relative >= ph.vaddr && static_cast<std::uint64_t>(relative) + size <=
+            static_cast<std::uint64_t>(ph.vaddr) + ph.memsz) return true;
+    }
+    return false;
+}
+
+bool ReadGuestInitializers(const GuestImage& image, GuestInitializers& out) {
+    if (image.ehdr.phentsize < sizeof(Elf32Phdr)) return false;
+    bool found = false;
+    for (std::uint32_t i = 0; i < image.ehdr.phnum; ++i) {
+        Elf32Phdr ph{};
+        if (!ReadStruct(image.file, static_cast<std::size_t>(image.ehdr.phoff) +
+                        static_cast<std::size_t>(i) * image.ehdr.phentsize, ph)) return false;
+        if (ph.type != 2u) continue; // PT_DYNAMIC
+        if (found || ph.filesz % 8u || !RangeFits(ph.offset, ph.filesz, image.file.size())) return false;
+        found = true;
+        bool terminated = false;
+        for (std::size_t off = ph.offset; off < static_cast<std::size_t>(ph.offset) + ph.filesz; off += 8u) {
+            std::uint32_t tag = 0, value = 0;
+            if (!ReadStruct(image.file, off, tag) || !ReadStruct(image.file, off + 4u, value)) return false;
+            if (tag == 0u) { terminated = true; break; } // DT_NULL
+            if (tag == 12u) out.init = value; // DT_INIT
+            if (tag == 25u) out.array = value; // DT_INIT_ARRAY
+            if (tag == 27u) out.array_size = value; // DT_INIT_ARRAYSZ
+        }
+        if (!terminated) return false;
+    }
+    if (!found || out.array_size % 4u || (out.array_size && !out.array)) return false;
+    if (out.array_size && (!GuestSegmentContains(image, out.array, out.array_size, 4u) ||
+        static_cast<std::uint64_t>(image.base) + out.array + out.array_size > image.end)) return false;
+    if (out.init && !GuestSegmentContains(image, out.init & ~1u, 2u, 1u)) return false;
+    return true;
+}
+
+bool GuestInitializerExecutable(const std::vector<GuestImage>& images, std::uint32_t function) {
+    const std::uint32_t address = function & ~1u;
+    for (const auto& image : images) {
+        if (address >= image.base && address < image.end &&
+            GuestSegmentContains(image, address - image.base, (function & 1u) ? 2u : 4u, 1u)) return true;
+    }
+    return false;
 }
 
