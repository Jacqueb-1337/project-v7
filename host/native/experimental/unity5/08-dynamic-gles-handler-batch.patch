+            GLint pbo = 0;
+            glGetIntegerv(0x88ef, &pbo); // GL_PIXEL_UNPACK_BUFFER_BINDING
+            if (pbo) { pixels = reinterpret_cast<const void*>(static_cast<std::uintptr_t>(address)); return true; }
+        }
+        if (!address) return true;
+        std::uint64_t components = 0, bytes = 0;
+        switch (format) {
+            case 0x1903: case 0x1906: case 0x1909: case 0x1902: case 0x8d94: components=1; break;
+            case 0x190a: case 0x8227: case 0x8228: components=2; break;
+            case 0x1907: case 0x8d98: components=3; break;
+            case 0x1908: case 0x80e1: case 0x8d99: components=4; break;
+            case 0x84f9: components=1; break;
+            default: return false;
+        }
+        switch (type) {
+            case 0x1400: case 0x1401: bytes=components; break;
+            case 0x1402: case 0x1403: case 0x140b: case 0x8d61: bytes=2*components; break;
+            case 0x1404: case 0x1405: case 0x1406: bytes=4*components; break;
+            case 0x8033: case 0x8034: case 0x8363: bytes=2; break;
+            case 0x84fa: case 0x8368: case 0x8c3b: case 0x8c3e: bytes=4; break;
+            case 0x8dad: bytes=8; break;
+            default: return false;
+        }
+        GLint align=4, row=0, image=0, skipPixels=0, skipRows=0, skipImages=0;
+        glGetIntegerv(GL_UNPACK_ALIGNMENT, &align);
+        if (es3) {
+            glGetIntegerv(0x0cf2, &row); glGetIntegerv(0x806e, &image);
+            glGetIntegerv(0x0cf4, &skipPixels); glGetIntegerv(0x0cf3, &skipRows); glGetIntegerv(0x806d, &skipImages);
+        }
+        if (align <= 0 || align > 8 || row < 0 || image < 0 || skipPixels < 0 || skipRows < 0 || skipImages < 0) return false;
+        const std::uint64_t rowBytes=(std::uint64_t(row ? row : w)*bytes+align-1)/align*align;
+        const std::uint64_t rows=image ? image : h;
+        // Bound every intermediate to the guest address space before multiplication.
+        if (rowBytes > memory_.size() || rows > memory_.size() || (rows && rowBytes > memory_.size()/rows)) return false;
+        const std::uint64_t slice=rowBytes*rows;
+        const std::uint64_t depth=std::uint64_t(skipImages)+(d ? d-1 : 0);
+        const std::uint64_t lastRow=std::uint64_t(skipRows)+(h ? h-1 : 0);
+        if ((depth && slice > memory_.size()/depth) || (lastRow && rowBytes > memory_.size()/lastRow)) return false;
+        const std::uint64_t total=depth*slice+lastRow*rowBytes+(std::uint64_t(skipPixels)+w)*bytes;
+        if (total > memory_.size() || !Fits(address, static_cast<std::size_t>(total))) return false;
+        pixels=memory_.data()+address;
+        return true;
+    }
